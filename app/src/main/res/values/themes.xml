<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 浅色主题：Material Components DayNight，自动跟随系统深浅色 -->
    <style name="Theme.DSBalanceViewer" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ds_primary</item>
        <item name="colorPrimaryVariant">@color/ds_primary_dark</item>
        <item name="colorOnPrimary">@color/ds_on_primary</item>
        <item name="colorSecondary">@color/ds_primary</item>
        <item name="colorSecondaryVariant">@color/ds_primary_dark</item>
        <item name="colorOnSecondary">@color/ds_on_primary</item>

        <!-- edge-to-edge：状态栏透明，颜色由工具栏延伸补齐（刘海适配见 SystemBars） -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <!-- 柔和浅灰窗口底 + 次要文字色 -->
        <item name="android:windowBackground">@color/ds_window_light</item>
        <item name="android:textColorSecondary">@color/ds_muted_light</item>
    </style>

    <!-- 设置页的分组小标题：卡片外的小字，用来把页面切成几块 -->
    <style name="SettingsGroupTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 设置页卡片统一外观，避免每张卡重复写 5 个属性 -->
    <style name="SettingsCard" parent="Widget.MaterialComponents.CardView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardBackgroundColor">@color/ds_card</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
    </style>
</resources>
