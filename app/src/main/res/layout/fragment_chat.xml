<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:id="@+id/chatPage"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?android:attr/windowBackground" android:focusableInTouchMode="true" android:orientation="vertical">
    <LinearLayout android:id="@+id/header" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:gravity="center_vertical" android:background="?attr/colorPrimary" android:paddingHorizontal="6dp">
        <ImageButton android:id="@+id/history" android:layout_width="48dp" android:layout_height="48dp"
            android:contentDescription="历史对话" android:src="@drawable/ic_history_chat" android:tint="?attr/colorOnPrimary"
            android:background="?attr/selectableItemBackgroundBorderless" />
        <TextView android:id="@+id/model" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="start|center_vertical" android:textSize="17sp" android:textStyle="bold"
            android:textColor="?attr/colorOnPrimary" android:maxLines="2" android:ellipsize="end" />
        <ImageButton android:id="@+id/settings" android:layout_width="48dp" android:layout_height="48dp"
            android:contentDescription="对话设置" android:src="@drawable/ic_settings" android:tint="?attr/colorOnPrimary"
            android:background="?attr/selectableItemBackgroundBorderless" />
        <ImageButton android:id="@+id/newChat" android:layout_width="48dp" android:layout_height="48dp"
            android:contentDescription="新对话" android:src="@drawable/ic_add" android:tint="?attr/colorOnPrimary"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ScrollView android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout android:id="@+id/messages" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp" />
        </ScrollView>
        <ImageButton android:id="@+id/jumpLatest" android:layout_width="48dp" android:layout_height="48dp"
            android:layout_gravity="bottom|end" android:layout_margin="12dp"
            android:background="@drawable/chat_surface" android:elevation="4dp" android:visibility="gone"
            android:contentDescription="跳到最新回复" android:src="@drawable/chat_next" android:rotation="90"
            android:tint="?android:attr/textColorPrimary" />
        <LinearLayout android:id="@+id/welcome" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="center" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="48dp" android:layout_height="48dp" android:padding="11dp"
                android:src="@drawable/ic_chat" android:background="@drawable/chat_accent" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp"
                android:text="欢迎回来，随时开始吧" android:textSize="24sp" android:textStyle="bold" android:textColor="?android:attr/textColorPrimary" />
            <Button android:id="@+id/setup" style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="选择对话 API" />
        </LinearLayout>
    </FrameLayout>
    <TextView android:id="@+id/notice" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingHorizontal="18dp" android:accessibilityLiveRegion="polite" android:textSize="13sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="12dp"
        android:elevation="3dp" android:orientation="vertical" android:padding="8dp" android:background="@drawable/chat_surface">
        <HorizontalScrollView android:id="@+id/attachmentPreview" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:visibility="gone" android:scrollbars="none">
            <LinearLayout android:id="@+id/attachmentItems" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:orientation="horizontal" android:padding="4dp" />
        </HorizontalScrollView>
        <EditText android:id="@+id/input" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:maxLines="5" android:hint="输入消息…" android:inputType="textMultiLine|textCapSentences"
            android:textSize="16sp" android:paddingHorizontal="10dp" android:background="@android:color/transparent" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <com.google.android.material.chip.Chip android:id="@+id/thinking" style="@style/ChatModeChip"
                android:text="深度思考" app:chipIcon="@drawable/ic_mode_thinking" />
            <com.google.android.material.chip.Chip android:id="@+id/search" style="@style/ChatModeChip"
                android:text="智能搜索" app:chipIcon="@drawable/ic_mode_search" />
            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <TextView android:id="@+id/attach" android:contentDescription="添加附件" android:text="⊕"
                android:textSize="26sp" android:gravity="center" android:layout_width="44dp" android:layout_height="48dp" />

            <ImageButton android:id="@+id/send" android:layout_width="48dp" android:layout_height="48dp"
            android:contentDescription="发送" android:src="@drawable/ic_send_chat" android:tint="@color/white"
            android:background="@drawable/chat_accent" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

    <LinearLayout android:id="@+id/historyPanel" android:layout_gravity="start" android:layout_width="300dp"
        android:layout_height="match_parent" android:orientation="vertical" android:background="@color/ds_card"
        android:focusableInTouchMode="true" android:paddingHorizontal="16dp">
        <EditText android:id="@+id/historySearch" android:layout_width="match_parent" android:layout_height="48dp"
            android:drawableStart="@drawable/ic_history_search" android:drawablePadding="8dp" android:singleLine="true" android:hint="搜索对话内容…" android:imeOptions="actionSearch" android:inputType="text"
            android:layout_marginTop="16dp" android:paddingHorizontal="16dp" android:background="@drawable/chat_bubble" />
        <LinearLayout android:id="@+id/batchBar" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:visibility="gone" android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="8dp">
            <Button android:id="@+id/batchAll" style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="0dp" android:paddingHorizontal="6dp" android:text="全选" android:textSize="13sp" />
            <Button android:id="@+id/batchNone" style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="0dp" android:paddingHorizontal="6dp" android:text="取消" android:textSize="13sp" />
            <TextView android:id="@+id/batchCount" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center" android:textSize="13sp" />
            <Button android:id="@+id/batchExit" style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="0dp" android:paddingHorizontal="6dp" android:text="退出" android:textSize="13sp" />
        </LinearLayout>
        <Button android:id="@+id/batchDelete" style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"
            android:textColor="?android:attr/textColorPrimary" android:text="删除选中" />
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <LinearLayout android:id="@+id/historyRows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
        </ScrollView>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
